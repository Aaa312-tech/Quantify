* text=auto eol=lf
*.png binary
*.pdf binary
*.joblib binary
*.npz binary
*.npy binary
*.gz binary

# Preserve the exact bytes of research evidence, including historical CRLF files.
data/** -text linguist-generated=true
data/raw/** -whitespace
artifacts/** -text linguist-generated=true
# Frozen JSON receipts may retain Windows line endings; still check real trailing whitespace.
artifacts/checks/**/*.json whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Verbatim runner logs retain pytest padding and native line endings.
artifacts/checks/**/*.log -whitespace
reports/** linguist-generated=true
docs/references/** -text
configs/experiment.json -text

# Large datasets and fitted estimators are downloaded through Git LFS.
*.joblib filter=lfs diff=lfs merge=lfs -text

# Bulk primary-source archives remain available without enlarging every code checkout.
data/raw/disclosures_*/documents/*.pdf filter=lfs diff=lfs merge=lfs -text
data/raw/capco_industries_*/**/*.pdf filter=lfs diff=lfs merge=lfs -text
data/raw/etf_*/**/*.pdf filter=lfs diff=lfs merge=lfs -text
